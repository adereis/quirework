  "phases": [
    {
      "name": "opening",
      "rounds": 1,
      "instruction": "Before anyone drafts: what must this chapter do, what must it not do, and the one thing you would fight for. You are writing blind to your colleagues this round; say what you think, not what you expect them to say."
    },
    {
      "name": "must-do",
      "rounds": 1,
      "instruction": "Read the board. Answer your colleagues by name: where you agree, where you do not, and what you would now change in your own position. Still no drafting."
