// The site as a Cloudflare Worker serving static assets. Workers Builds
// runs `hugo` in site/ and then a pinned Wrangler on every push to main;
// the build settings live in the dashboard (README.md, "Deploy").
{
  // Must match the Worker's name in the dashboard, or the build fails.
  "name": "quirework-site",
  "compatibility_date": "2026-10-11",

  // Assets only: no script, so no "main".
  "assets": {
    "directory": "./public",
    // Serve public/404.html with a 404 status. The default, "none",
    // answers an unknown path with an empty 404.
    "not_found_handling": "404-page"
  },

  // The apex is a Custom Domain, declared here so that no deploy can
  // drop it. Cloudflare creates its DNS record and certificate. It must
  // match `baseURL` in hugo.toml.
  "routes": [{ "pattern": "quirework.com", "custom_domain": true }],

  // One public address. No workers.dev copy of the site, and no
  // reachable preview of an unpublished branch.
  "workers_dev": false,
  "preview_urls": false
}
